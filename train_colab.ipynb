 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🚀 Unsloth Fine-Tuning Pipeline: Đà Nẵng & Quảng Nam Wedding Tráp Advisor (Qwen2.5-14B / 7B)\n",
    "### Google Colab (QLoRA 4-bit) Fine-Tune Qwen2.5-14B-Instruct / 7B-Instruct + Tự động lưu Google Drive + GGUF export cho Ollama\n",
    "\n",
    "Hệ thống tự động:\n",
    "1. Mount Google Drive tự động để lưu trữ dataset và kết quả mô hình không sợ mất kết nối.\n",
    "2. Fine-tune mô hình `unsloth/Qwen2.5-14B-Instruct-bnb-4bit` (hoặc 7B) trên GPU T4 / L4 / A100 bằng Unsloth.\n",
    "3. Export mô hình sang định dạng **GGUF** (`q4_k_m`) và tự động tạo `Modelfile` cho Ollama.\n",
    "4. Đẩy mô hình GGUF lên **Hugging Face Hub** (Tùy chọn)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. KẾT NỐI GOOGLE DRIVE & KIỂM TRA GPU\n",
    "import os\n",
    "os.environ[\"WANDB_DISABLED\"] = \"true\"  # Tắt Wandb tránh lỗi circular import\n",
    "\n",
    "try:\n",
    "    from google.colab import drive\n",
    "    drive.mount('/content/drive')\n",
    "    print(\"✅ Đã kết nối thành công Google Drive!\")\n",
    "    OUTPUT_DIR = \"/content/drive/MyDrive/Qwen2.5-14B-FineTuned\"\n",
    "except Exception as e:\n",
    "    print(f\"⚠️ Không phải Colab hoặc lỗi mount Drive: {e}\")\n",
    "    OUTPUT_DIR = \"./outputs_qwen14b\"\n",
    "\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "!nvidia-smi\n",
    "import torch\n",
    "gpu_stats = torch.cuda.get_device_properties(0)\n",
    "print(f\"📌 GPU: {gpu_stats.name} | Total VRAM: {gpu_stats.total_memory / 1024**3:.2f} GB\")\n",
    "\n",
    "# Fix lỗi tương thích thư viện Unsloth + trl trên Colab\n",
    "!pip install --force-reinstall \"trl==0.8.6\"\n",
    "!pip install --upgrade --force-reinstall --no-cache-dir unsloth unsloth_zoo\n",
    "!pip install peft accelerate bitsandbytes datasets huggingface_hub"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. TÌM HOẶC UPLOAD DATASET (RAW_SAMPLES.JSONL / DATASET.JSONL)\n",
    "import os\n",
    "import glob\n",
    "\n",
    "possible_paths = [\n",
    "    \"/content/drive/MyDrive/raw_samples.jsonl\",\n",
    "    \"/content/drive/MyDrive/data-train/raw_samples.jsonl\",\n",
    "    \"/content/drive/MyDrive/dataset.jsonl\",\n",
    "    \"data-train/raw_samples.jsonl\",\n",
    "    \"raw_samples.jsonl\",\n",
    "    \"dataset.jsonl\",\n",
    "    \"./data/dataset_train.jsonl\"\n",
    "]\n",
    "\n",
    "DATASET_PATH = None\n",
    "for p in possible_paths:\n",
    "    if os.path.exists(p):\n",
    "        DATASET_PATH = p\n",
    "        break\n",
    "\n",
    "if not DATASET_PATH:\n",
    "    print(\"👉 Vui lòng upload file raw_samples.jsonl của bạn lên Colab:\")\n",
    "    from google.colab import files\n",
    "    uploaded = files.upload()\n",
    "    DATASET_PATH = list(uploaded.keys())[0]\n",
    "\n",
    "print(f\"✅ Sử dụng dataset: {DATASET_PATH}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. LOAD MÔ HÌNH QWEN2.5-14B-INSTRUCT VÀ THIẾT LẬP QLORA\n",
    "from unsloth import FastLanguageModel\n",
    "\n",
    "max_seq_length = 2048  # Context length\n",
    "model_name = \"unsloth/Qwen2.5-14B-Instruct-bnb-4bit\"  # Hoặc \"unsloth/Qwen2.5-7B-Instruct-bnb-4bit\"\n",
    "\n",
    "print(f\"📦 Loading model {model_name}...\")\n",
    "model, tokenizer = FastLanguageModel.from_pretrained(\n",
    "    model_name = model_name,\n",
    "    max_seq_length = max_seq_length,\n",
    "    dtype = None,\n",
    "    load_in_4bit = True,\n",
    ")\n",
    "\n",
    "# Cấu hình QLoRA Adapters\n",
    "model = FastLanguageModel.get_peft_model(\n",
    "    model,\n",
    "    r = 16,\n",
    "    target_modules = [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\", \"gate_proj\", \"up_proj\", \"down_proj\"],\n",
    "    lora_alpha = 16,\n",
    "    lora_dropout = 0,\n",
    "    bias = \"none\",\n",
    "    use_gradient_checkpointing = \"unsloth\", # Tiết kiệm ~30% VRAM\n",
    "    random_state = 3407,\n",
    ")\n",
    "print(\"✅ Mô hình Qwen2.5-14B QLoRA đã sẵn sàng trên Colab!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. FORMAT DATASET THEO CHUẨN CHAT TEMPLATE QWEN2.5\n",
    "from datasets import load_dataset\n",
    "from unsloth.chat_templates import get_chat_template\n",
    "\n",
    "tokenizer = get_chat_template(\n",
    "    tokenizer,\n",
    "    chat_template = \"qwen-2.5\",\n",
    ")\n",
    "\n",
    "def formatting_prompts_func(examples):\n",
    "    convs = examples[\"messages\"]\n",
    "    texts = [tokenizer.apply_chat_template(convo, tokenize = False, add_generation_prompt = False) for convo in convs]\n",
    "    return { \"text\" : texts, }\n",
    "\n",
    "full_ds = load_dataset(\"json\", data_files=DATASET_PATH, split=\"train\")\n",
    "split_ds = full_ds.train_test_split(test_size=0.1, seed=3407)\n",
    "\n",
    "train_ds = split_ds[\"train\"].map(formatting_prompts_func, batched = True)\n",
    "eval_ds = split_ds[\"test\"].map(formatting_prompts_func, batched = True)\n",
    "\n",
    "print(f\"📊 Total: {len(full_ds)} | Train: {len(train_ds)} | Validation: {len(eval_ds)}\")\n",
    "print(\"Sample prompt:\")\n",
    "print(train_ds[0][\"text\"][:350])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. TIẾN HÀNH FINE-TUNE VỚI SFTTRAINER\n",
    "from trl import SFTTrainer\n",
    "from transformers import TrainingArguments\n",
    "from unsloth import is_bfloat16_supported\n",
    "\n",
    "checkpoints_dir = os.path.join(OUTPUT_DIR, \"checkpoints\")\n",
    "\n",
    "trainer = SFTTrainer(\n",
    "    model = model,\n",
    "    tokenizer = tokenizer,\n",
    "    train_dataset = train_ds,\n",
    "    eval_dataset = eval_ds,\n",
    "    dataset_text_field = \"text\",\n",
    "    max_seq_length = max_seq_length,\n",
    "    dataset_num_proc = 2,\n",
    "    packing = False,\n",
    "    args = TrainingArguments(\n",
    "        per_device_train_batch_size = 2,\n",
    "        gradient_accumulation_steps = 4,\n",
    "        warmup_steps = 10,\n",
    "        num_train_epochs = 3,\n",
    "        learning_rate = 2e-4,\n",
    "        fp16 = not is_bfloat16_supported(),\n",
    "        bf16 = is_bfloat16_supported(),\n",
    "        logging_steps = 5,\n",
    "        evaluation_strategy = \"steps\",\n",
    "        eval_steps = 20,\n",
    "        save_strategy = \"steps\",\n",
    "        save_steps = 20,\n",
    "        optim = \"adamw_8bit\",\n",
    "        weight_decay = 0.01,\n",
    "        lr_scheduler_type = \"linear\",\n",
    "        seed = 3407,\n",
    "        output_dir = checkpoints_dir,\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\"🔥 Bắt đầu Huấn luyện trên Colab...\")\n",
    "trainer_stats = trainer.train()\n",
    "print(f\"🎉 Hoàn tất trong {trainer_stats.metrics['train_runtime']:.2f} giây!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. THỬ NGHIỆM INFERENCE MÔ HÌNH VỪA TRAIN\n",
    "FastLanguageModel.for_inference(model)\n",
    "\n",
    "messages = [\n",
    "    {\"role\": \"system\", \"content\": \"Bạn là Chuyên viên Tư vấn Tráp Cưới cao cấp Đà Nẵng & Quảng Nam của Tráp Lễ Cưới Hỏi Thiên Di.\"},\n",
    "    {\"role\": \"user\", \"content\": \"Dạ shop ơi, em ở Hội An muốn đặt Bộ 5 Tráp Rồng Phượng giao về nhà thì ship thế nào ạ? Với em muốn đem bánh su xê riêng tới shop đơm giúp được không?\"},\
    "]\n",
    "inputs = tokenizer.apply_chat_template(\n",
    "    messages,\n",
    "    tokenize = True,\n",
    "    add_generation_prompt = True,\n",
    "    return_tensors = \"pt\"\n",
    ").to(\"cuda\")\n",
    "\n",
    "outputs = model.generate(input_ids = inputs, max_new_tokens = 300, use_cache = True)\n",
    "response = tokenizer.batch_decode(outputs)[0]\n",
    "print(\"--- PHẢN HỒI THỬ NGHIỆM --- \")\n",
    "if \"<|im_start|>assistant\" in response:\n",
    "    print(response.split(\"<|im_start|>assistant\\n\")[1].replace(\"<|im_end|>\", \"\").strip())\n",
    "else:\n",
    "    print(response)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. EXPORT MÔ HÌNH SANG GGUF Q4_K_M VÀ TẠO MODELFILE CHO OLLAMA VÀO GOOGLE DRIVE\n",
    "GGUF_PATH = os.path.join(OUTPUT_DIR, \"qwen2.5_14b_gguf\")\n",
    "model.save_pretrained_gguf(GGUF_PATH, tokenizer, quantization_method = \"q4_k_m\")\n",
    "\n",
    "modelfile_path = os.path.join(GGUF_PATH, \"Modelfile_qwen14b\")\n",
    "modelfile_content = \"\"\"FROM ./unsloth.Q4_K_M.gguf\n",
    "\n",
    "TEMPLATE \"\"\"{{ if .System }}<|im_start|>system\n",
    "{{ .System }}<|im_end|>\n",
    "{{ end }}{{ if .Prompt }}<|im_start|>user\n",
    "{{ .Prompt }}<|im_end|>\n",
    "{{ end }}<|im_start|>assistant\n",
    "{{ .Response }}<|im_end|>\"\"\"\n",
    "\n",
    "PARAMETER stop \"<|im_start|>\"\n",
    "PARAMETER stop \"<|im_end|>\"\n",
    "PARAMETER temperature 0.7\n",
    "PARAMETER top_p 0.9\n",
    "\"\"\"\n",
    "\n",
    "with open(modelfile_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(modelfile_content)\n",
    "\n",
    "print(f\"🎉 HOÀN TẤT! File mô hình GGUF và Modelfile đã lưu tại: {GGUF_PATH}\")"
   ]
  }
 ],
